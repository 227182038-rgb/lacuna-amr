ue, groupName: 'entrez_pg', adjustFit:'none'"><a href="#" sourceContent="send_to_menu2" class="tgt_dark">Send to:</a><script type="text/javascript">
                        jQuery(document).ready( function () {
                            jQuery("#send_to_menu2 input[type='radio']").click( function () {
                                var selectedValue = jQuery(this).val().toLowerCase();
                                var selectedDiv = jQuery("#send_to_menu2 div." + selectedValue);
                                
                                if(selectedDiv.is(":hidden")){ 
                                    jQuery("#send_to_menu2 div.submenu:visible").slideUp();
                                    selectedDiv.slideDown();
                                }
                            });
                        
                        });
                        
                        jQuery("#sendto2").bind("ncbipopperclose", function(){
                            jQuery("#send_to_menu2 div.submenu:visible").css("display","none");
                            jQuery("#send_to_menu2 input[type='radio']:checked").attr("checked",false);
                        });
                        
                    </script></h4><div id="send_to_menu2" class="tabPopper send_to"><fieldset><legend>Choose Destination</legend><ul class="column_list"><li><input type="radio" name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.SendTo" sid="11" value="File" id="dest_File2" /><label for="dest_File2">File</label></li><li><input type="radio" name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.SendTo" sid="12" value="AddToClipboard" id="dest_AddToClipboard2" /><label for="dest_AddToClipboard2">Clipboard</label></li><li><input type="radio" name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.SendTo" sid="13" value="AddToCollections" id="dest_AddToCollections2" /><label for="dest_AddToCollections2">Collections</label></li></ul></fieldset><div class="submenu file" id="submenu_File2" style="display: none;"><p id="submenu_File_hint2" class="hidden"></p><ul><li><label for="file_format2">Format</label><select id="file_format2" name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.FFormat2" sid="101"><option value="docsum" format="text" selected="selected">Summary (text)</option><option value="full" format="text">Full (text)</option><option value="fullxml" format="text">Full XML (text)</option><option value="uilist" format="text">BioSample ID list</option><option value="acclist" format="text">Accessions List</option></select></li><li><label for="file_sort2">Sort by</label><select id="file_sort2" name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.FSort2" sid="51"><option value="">Default order</option><option value="WITHDATA" selected="selected">Has related data</option></select></li></ul><button name="EntrezSystem2.PEntrez.BioSample.BioSample_ResultsPanel.BioSample_DisplayBar.SendToSubmit" sid="11" class="button_apply file ncbipopper-close-button" type="submit" cmd="File">Create File</button></div><div class="submenu addtoclipboard