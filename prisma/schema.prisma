// LACUNA-AMR web console — Prisma schema
// Runs of the audit/predict engines and service-layer requests are persisted
// so every interactive result shown in the UI is traceable to a stored record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A run of `audit-dataset` (label-heterogeneity audit + data-gate verdicts),
// executed either on the bundled pilot cohort or on a user-pasted AST table.
model AuditRun {
  id          String   @id @default(cuid())
  source      String // "cohort" (bundled pilot data) | "paste" (user TSV)
  drug        String // drug the verdict row refers to, or "ALL"
  verdict     String // PASS | FAIL
  nLabelled   Int // labelled S/R isolates considered by the data gate
  summary     String // one-line human summary
  input       String // JSON: audit input descriptor (source, thresholds, row count)
  results     String // JSON: full per-drug audit output (distributions + DG checks)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// A single conformal-prediction lookup against the trained per-drug engine.
model PredictRun {
  id           String   @id @default(cuid())
  drug         String
  isolate      String? // biosample accession when a cohort isolate was scored
  modelType    String // M0 | M1 | M2
  m0Call       String? // S | R
  pR           Float? // calibrated probability of resistance (M1/M2)
  call         String? // S | R (thresholded)
  conformalSet String? // S | R | S+R | ABSTAIN
  input        String // JSON: feature toggles / isolate descriptor
  output       String // JSON: full engine output incl. determinants + thresholds
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A re-run of the split-leakage auditor (G3-style) on the sealed pilot splits.
model ValidateRun {
  id        String   @id @default(cuid())
  drug      String
  problems  Int // number of leakage problems found
  verdict   String // PASS | FAIL
  results   String // JSON: per-split overlap detail
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Service-layer inquiry (S1/S2/S3 SKU sheets; S3 is documented as blocked).
model ServiceRequest {
  id        String   @id @default(cuid())
  sku       String // S1 | S2 | S3
  name      String
  email     String
  org       String?
  isolates  Int? // approximate collection size
  message   String?
  status    String   @default("received")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Commercial layer (added 2026-11-04, see DEVIATIONS.md D-022..D-029)
// ---------------------------------------------------------------------------

// Append-only, hash-chained audit trail (21 CFR Part 11-style record keeping,
// research-use). Each entry's hash = sha256(seq | prevHash | actor | action |
// detail | createdAtISO), so tampering with any row breaks every later hash.
model AuditLog {
  seq       Int      @id @default(autoincrement())
  id        String   @unique @default(cuid())
  actor     String // "console" | "api:<keyPrefix>"
  action    String // e.g. "predict.run", "batch.submit", "export.fhir", "key.issue"
  detail    String // JSON descriptor (never payloads with personal data)
  hash      String // sha256 hex of this entry
  prevHash  String? // hash of the previous entry (null = genesis)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// API keys for programmatic access (lab pipeline integration). The full key is
// shown once at issue; only its sha256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  label      String
  keyPrefix  String // first 12 chars, for display
  keyHash    String // sha256(full key)
  scope      String @default("read+predict") // "read" | "read+predict"
  credits    Int       @default(100) // per-sample credits remaining
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// Batch scoring queue. Work is processed in chunks (see DEVIATIONS.md D-26):
// each poll of GET /api/batch?id= advances the job by CHUNK isolates using the
// deterministic engine, so progress reflects real computation.
model BatchJob {
  id        String   @id @default(cuid())
  label     String
  drug      String
  modelType String   @default("M1")
  n         Int // isolates submitted
  done      Int      @default(0) // isolates scored so far
  status    String   @default("queued") // queued | running | complete | failed
  isolates  String // JSON array of biosamples (frozen at submission)
  results   String   @default("[]") // JSON array of per-isolate predictions
  summary   String? // JSON aggregate, written at completion
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Integration & API layer (added 2026-11-09, v0.4.0)
// ---------------------------------------------------------------------------

// Single-row-per-platform outbound connector config (currently "vecura").
// hmacSecret is stored in full (console-only deployment, RUO demo boundary);
// it is masked to its first 4 chars everywhere it is displayed.
model IntegrationConfig {
  id             String    @id @default(cuid())
  platform       String    @default("vecura")
  endpointUrl    String?
  hmacSecret     String
  events         String    @default("[]") // JSON array of subscribed outbound event types
  active         Boolean   @default(true)
  lastTestedAt   DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Every outbound/inbound webhook exchange (ping tests, signed event deliveries,
// inbound signature verifications) with its real outcome — delivered/failed
// outcomes are recorded honestly, including sandbox network failures.
model WebhookEvent {
  id         String   @id @default(cuid())
  direction  String // "outbound" | "inbound"
  platform   String   @default("vecura")
  eventType  String
  payload    String // JSON
  status     String // "verified" | "rejected" | "delivered" | "failed"
  httpStatus Int?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
